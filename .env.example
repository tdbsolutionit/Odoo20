# ================================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# ================================================================================
# Sao chép file này thành .env và điền thông tin bảo mật trước khi chạy:
#   cp .env.example .env
# ================================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=your_secure_password_here

# Odoo Container Environment
HOST=db
PORT=5432
USER=odoo
PASSWORD=your_secure_password_here

# Web Port Exposure
ODOO_PORT=8069

# Master Password for Database Management (Database Manager)
ODOO_ADMIN_PASSWORD=admin_master_password_change_me
