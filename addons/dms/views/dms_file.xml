<odoo>
    <record id="search_dms_file" model="ir.ui.view">
        <field name="name">dms_file.search</field>
        <field name="model">dms.file</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="[('name','ilike',self)]" />
                <filter
                    string="All Files"
                    name="all"
                    domain="['|',('active', '=',  False), ('active', '!=',  False)]"
                />
                <filter
                    string="My Files"
                    name="filter_user"
                    domain="[('create_uid', '=', uid)]"
                />
                <separator />
                <filter
                    string="Archived Files"
                    name="filter_active"
                    domain="[('active', '=', False)]"
                />
                <separator />
                <filter
                    string="Creation Date"
                    name="filter_create"
                    date="create_date"
                />
                <filter
                    string="Modification Date"
                    name="filter_write"
                    date="write_date"
                />
                <group>
                    <filter
                        name="group_color"
                        string="Color"
                        domain="[]"
                        context="{'group_by':'color'}"
                    />
                    <filter
                        name="group_category"
                        string="Category"
                        domain="[]"
                        context="{'group_by':'category_id'}"
                    />
                    <separator />
                    <filter
                        name="group_storage"
                        string="Storage"
                        domain="[]"
                        context="{'group_by':'storage_id'}"
                    />
                    <filter
                        name="group_directory"
                        string="Directories"
                        domain="[]"
                        context="{'group_by':'directory_id'}"
                    />
                </group>
                <searchpanel>
                    <field
                        name="directory_id"
                        icon="fa-folder"
                        limit="0"
                        enable_counters="1"
                    />
                    <field
                        name="category_id"
                        icon="fa-users"
                        limit="0"
                        enable_counters="1"
                    />
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="view_dms_file_kanban" model="ir.ui.view">
        <field name="name">dms_file.kanban</field>
        <field name="model">dms.file</field>
        <field name="arch" type="xml">
            <kanban
                js_class="file_kanban"
                class="mk_file_kanban_view o_kanban_small_column o_kanban_mobile"
                banner_route="/onboarding/document_onboarding_file"
                highlight_color="color"
            >
                <field name="id" />
                <field name="tag_ids" />
                <field name="name" />
                <field name="color" />
                <field name="active" />
                <field name="mimetype" />
                <field name="icon_url" />
                <field name="create_uid" />
                <field name="write_date" />
                <field name="locked_by" />
                <field name="is_locked" />
                <field name="is_lock_editor" />
                <field name="permission_write" />
                <field name="permission_unlink" />
                <field name="can_download" />
                <field name="can_manage_download" />
                <field name="is_downloadable" />
                <field name="write_date" />
                <templates>
                    <t t-name="menu">
                        <div class="container px-3 py-2" style="min-width: 310px;">
                            <div class="row">
                                <div name="card_menu_Operations" class="col-7 pe-2 ps-2">
                                    <h5
                                        role="menuitem"
                                        class="o_kanban_card_manage_title text-nowrap fw-bold mb-2"
                                    >
                                        <span>Operations</span>
                                    </h5>
                                    <div
                                        role="menuitem"
                                        t-if="record.can_manage_download.raw_value and record.is_downloadable.raw_value"
                                        class="text-nowrap mb-1"
                                    >
                                        <a name="action_toggle_downloadable" type="object" class="text-danger text-nowrap text-decoration-none">
                                            <i class="fa fa-lock me-1" />
                                            Khóa tải về
                                        </a>
                                    </div>
                                    <div
                                        role="menuitem"
                                        t-if="record.can_manage_download.raw_value and !record.is_downloadable.raw_value"
                                        class="text-nowrap mb-1"
                                    >
                                        <a name="action_toggle_downloadable" type="object" class="text-success text-nowrap text-decoration-none">
                                            <i class="fa fa-unlock me-1" />
                                            Cho phép tải về
                                        </a>
                                    </div>
                                    <div
                                        role="menuitem"
                                        t-if="record.permission_write.raw_value and !record.is_locked.raw_value"
                                        class="text-nowrap mb-1"
                                    >
                                        <a name="lock" type="object" class="text-nowrap text-decoration-none">
                                            <i class="fa fa-lock me-1" />
                                            Lock
                                        </a>
                                    </div>
                                    <div
                                        role="menuitem"
                                        t-if="record.is_locked.raw_value and record.is_lock_editor.raw_value"
                                        class="text-nowrap mb-1"
                                    >
                                        <a name="unlock" type="object" class="text-nowrap text-decoration-none">
                                            <i class="fa fa-unlock-alt me-1" />
                                            Unlock
                                        </a>
                                    </div>
                                    <div
                                        role="menuitem"
                                        t-if="record.permission_write.raw_value and record.active.raw_value and (!record.is_locked.raw_value or (record.is_locked.raw_value and record.is_lock_editor.raw_value))"
                                        class="text-nowrap mb-1"
                                    >
                                        <a name="toggle_active" type="object" class="text-nowrap text-decoration-none">
                                            <i class="fa fa-archive me-1" />
                                            Archive
                                        </a>
                                    </div>
                                    <div
                                        role="menuitem"
                                        t-if="record.permission_write.raw_value and !record.active.raw_value and (!record.is_locked.raw_value or (record.is_locked.raw_value and record.is_lock_editor.raw_value))"
                                        class="text-nowrap mb-1"
                                    >
                                        <a name="toggle_active" type="object" class="text-nowrap text-decoration-none">
                                            <i class="fa fa-archive me-1" />
                                            Unarchive
                                        </a>
                                    </div>
                                    <div role="menuitem" t-if="record.can_download.raw_value" class="text-nowrap mb-1">
                                        <a
                                            t-attf-href="/dms/file/#{record.id.raw_value}/download"
                                            class="text-nowrap fw-semibold text-primary text-decoration-none"
                                        >
                                            <i class="fa fa-download me-1" />
                                            Download
                                        </a>
                                    </div>
                                </div>
                                <div class="col-5 ps-2 o_kanban_manage_actions">
                                    <h5
                                        role="menuitem"
                                        class="o_kanban_card_manage_title text-nowrap fw-bold mb-2"
                                    >
                                        <span>Actions</span>
                                    </h5>
                                    <div role="menuitem" class="text-nowrap mb-1">
                                        <a type="open" class="text-nowrap text-decoration-none">
                                            <i class="fa fa-external-link me-1" />
                                            Open
                                        </a>
                                    </div>
                                    <div
                                        role="menuitem"
                                        t-if="record.permission_write.raw_value"
                                        class="text-nowrap mb-1"
                                    >
                                        <a type="edit" class="text-nowrap text-decoration-none">
                                            <i class="fa fa-pencil-square-o me-1" />
                                            Edit
                                        </a>
                                    </div>
                                    <div
                                        role="menuitem"
                                        t-if="record.permission_unlink.raw_value and (!record.is_locked.raw_value or (record.is_locked.raw_value and record.is_lock_editor.raw_value))"
                                        class="text-nowrap mb-1"
                                    >
                                        <a type="delete" class="text-danger text-nowrap text-decoration-none">
                                            <i class="fa fa-trash-o me-1" />
                                            Delete
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_card_manage_actions row mt-2 pt-2 border-top">
                                <div
                                    role="menuitem"
                                    aria-haspopup="true"
                                    class="col-12"
                                    t-if="record.permission_write.raw_value"
                                >
                                    <field name="color" widget="kanban_color_picker" />
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="card" class="flex-row">
                        <main>
                            <div
                                t-attf-class="oe_kanban_global_click oe_kanban_content row g-0"
                            >
                                <div class="col-3">
                                    <a
                                        type="open"
                                        class="h-100 d-block o_kanban_dms_file_preview cursor-pointer"
                                        t-att-data-id="record.id.raw_value"
                                        t-att-id="record.id.raw_value"
                                        t-att-name="record.name.raw_value"
                                        title="Xem trước tài liệu"
                                        role="button"
                                    >
                                        <img
                                            t-att-src="record.icon_url.raw_value"
                                            style="height:70px;"
                                            alt="Icon"
                                        />
                                    </a>
                                </div>
                                <div class="col-9 ps-2">
                                    <field name="name" class="fw-bold d-block text-truncate" />
                                    <field
                                        name="tag_ids"
                                        widget="many2many_tags"
                                        options="{'color_field': 'color'}"
                                    />
                                    <div class="text-muted small">
                                        <field name="write_date" widget="date" />
                                    </div>
                                    <div class="text-secondary small d-flex align-items-center text-truncate" title="Người đăng tải">
                                        <i class="fa fa-user me-1 text-muted" />
                                        <field name="create_uid" class="text-truncate" />
                                    </div>
                                </div>
                                <footer class="mt-auto pt-0 ms-1 d-flex align-items-center">
                                    <a
                                        type="open"
                                        role="button"
                                        class="btn btn-sm btn-link p-0 text-primary text-decoration-none o_dms_preview_btn"
                                        title="Xem trước tài liệu"
                                    >
                                        <i class="fa fa-eye me-1"/>Xem trước
                                    </a>
                                    <button
                                        name="action_toggle_downloadable"
                                        type="object"
                                        t-if="record.can_manage_download.raw_value and record.is_downloadable.raw_value"
                                        class="btn btn-sm btn-outline-success p-0 px-2 ms-2 text-decoration-none"
                                        title="Đang cho phép tải về. Nhấp để khóa tải về."
                                    >
                                        <i class="fa fa-check-circle me-1"/>Cho tải
                                    </button>
                                    <button
                                        name="action_toggle_downloadable"
                                        type="object"
                                        t-if="record.can_manage_download.raw_value and !record.is_downloadable.raw_value"
                                        class="btn btn-sm btn-outline-danger p-0 px-2 ms-2 text-decoration-none"
                                        title="Đang khóa tải về. Nhấp để cho phép tải về."
                                    >
                                        <i class="fa fa-lock me-1"/>Khóa tải
                                    </button>
                                    <span
                                        t-if="!record.can_manage_download.raw_value and record.is_downloadable.raw_value"
                                        class="badge text-bg-success ms-2"
                                        title="Tệp này được phép tải về"
                                    >
                                        <i class="fa fa-check-circle me-1"/>Cho tải
                                    </span>
                                    <span
                                        t-if="!record.can_manage_download.raw_value and !record.is_downloadable.raw_value"
                                        class="badge text-bg-danger ms-2"
                                        title="Tệp này bị khóa tải về"
                                    >
                                        <i class="fa fa-lock me-1"/>Khóa tải
                                    </span>
                                    <div class="d-flex ms-auto oe_kanban_bottom_right">
                                        <span
                                            t-if="record.is_locked.raw_value"
                                            class="o_dms_file_kanban_lock"
                                        >
                                            <i
                                                t-attf-class="fa #{(record.is_locked.raw_value and !record.is_lock_editor.raw_value) ? 'fa-lock' : ''} #{((record.is_locked.raw_value and record.is_lock_editor.raw_value)) ? 'fa-unlock-alt' : ''}"
                                                t-att-title="record.locked_by.value"
                                            />
                                        </span>
                                        <img
                                            t-attf-src="/web/image/res.users/#{record.create_uid.raw_value}/avatar_128"
                                            t-att-alt="record.create_uid.value"
                                            class="oe_kanban_avatar"
                                            style="max-width:20px;"
                                        />
                                    </div>
                                </footer>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!-- Base view that can be overwritten by other modules as needed !-->
    <record id="view_dms_file_kanban_wizard_selection" model="ir.ui.view">
        <field name="name">dms_file.kanban.wizard.selection</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="dms.view_dms_file_kanban" />
        <field name="priority">9999</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="banner_route" />
                <attribute name="class">o_kanban_mobile mk_file_kanban_view</attribute>
            </kanban>
            <xpath expr="//div[hasclass('oe_kanban_bottom_right')]" position="replace">
                <div class="oe_kanban_bottom_right" />
            </xpath>
        </field>
    </record>
    <record id="view_dms_file_tree" model="ir.ui.view">
        <field name="name">dms_file.list</field>
        <field name="model">dms.file</field>
        <field name="arch" type="xml">
            <list
                js_class="file_list"
                decoration-warning="not active"
                decoration-muted="(is_locked and not is_lock_editor)"
                multi_edit="1"
                default_order="name asc"
            >
                <field name="active" column_invisible="1" />
                <field name="is_locked" column_invisible="1" />
                <field name="is_lock_editor" column_invisible="1" />
                <field name="name" />
                <field name="directory_id" optional="hide" />
                <field name="root_directory_id" optional="hide" />
                <field name="write_date" />
                <field name="create_uid" string="Người đăng tải" optional="show" widget="many2one_avatar_user" />
                <field name="human_size" string="Size" />
                <field name="mimetype" />
                <field name="category_id" column_invisible="1" />
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color', 'no_create_edit': True}"
                />
                <field name="can_download" column_invisible="True" />
                <field name="can_manage_download" column_invisible="True" />
                <field
                    name="is_downloadable"
                    widget="boolean_toggle"
                    readonly="not can_manage_download"
                    optional="show"
                    string="Cho phép tải về"
                />
                <button
                    name="action_preview_file"
                    type="object"
                    icon="fa-eye"
                    title="Xem trước"
                    string="Xem trước"
                />
                <button
                    name="action_download_file"
                    type="object"
                    icon="fa-download"
                    title="Tải về"
                    string="Tải về"
                    invisible="not can_download"
                />
            </list>
        </field>
    </record>
    <record id="view_dms_file_graph" model="ir.ui.view">
        <field name="name">dms_file.graph</field>
        <field name="model">dms.file</field>
        <field name="arch" type="xml">
            <graph type="pie">
                <field name="directory_id" type="row" />
                <field name="size" type="measure" />
            </graph>
        </field>
    </record>
    <record id="view_dms_file_pivot" model="ir.ui.view">
        <field name="name">dms_file.pivot</field>
        <field name="model">dms.file</field>
        <field name="arch" type="xml">
            <pivot display_quantity="true">
                <field name="storage_id" type="row" />
                <field name="directory_id" type="row" />
                <field name="size" type="measure" />
            </pivot>
        </field>
    </record>
    <record id="view_dms_file_form" model="ir.ui.view">
        <field name="name">dms_file.form</field>
        <field name="model">dms.file</field>
        <field name="arch" type="xml">
            <form string="Files">
                <header>
                    <button
                        class="oe_highlight"
                        name="action_preview_file"
                        type="object"
                        string="Xem trước"
                        icon="fa-eye"
                        invisible="not content"
                    />
                    <button
                        name="action_download_file"
                        type="object"
                        string="Tải về"
                        icon="fa-download"
                        class="btn-secondary"
                        invisible="not can_download or not content"
                    />
                    <button
                        class="oe_highlight"
                        name="lock"
                        type="object"
                        string="Lock"
                        invisible="is_locked or not permission_write"
                    />
                    <button
                        class="oe_highlight"
                        name="unlock"
                        type="object"
                        string="Unlock"
                        invisible="not is_locked or not is_lock_editor"
                    />
                </header>
                <sheet>
                    <!-- locked ribbon first, so that archived ribbon appear above if archived-->
                    <widget
                        name="web_ribbon"
                        title="Locked"
                        bg_color="text-bg-info"
                        invisible="not is_locked or (is_locked and locked_by != uid)"
                    />
                    <widget
                        name="web_ribbon"
                        title="Locked"
                        bg_color="text-bg-warning"
                        invisible="not is_locked or (is_locked and locked_by == uid)"
                    />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <div class="oe_button_box" name="button_box" />
                    <field
                        name="image_1920"
                        widget="image"
                        class="oe_avatar"
                        nolabel="1"
                        options="{'image_preview': 'image_128'}"
                    />
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" />
                            <field name="active" invisible="1" />
                        </h1>
                        <h4>
                            <field
                                name="path_json"
                                widget="path_json"
                                options="{'prefix': True, 'suffix': False}"
                                invisible="not name or not directory_id"
                            />
                        </h4>
                    </div>
                    <group name="content">
                        <group>
                            <field name="content" filename="name" widget="preview_binary" />
                        </group>
                        <group>
                            <field name="extension" />
                            <field name="mimetype" />
                        </group>
                    </group>
                    <group name="settings">
                        <group>
                            <field
                                name="directory_id"
                                options="{'no_quick_create': True}"
                            />
                            <field
                                name="storage_id"
                                options="{'no_open': True}"
                                groups="!dms.group_dms_manager"
                            />
                            <field name="storage_id" groups="dms.group_dms_manager" />
                        </group>
                        <group>
                            <field
                                name="category_id"
                                placeholder="Internal / Human Resource"
                                options="{'no_open': True, 'no_create': True}"
                            />
                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                                placeholder="Tags..."
                                options="{'color_field': 'color', 'no_create_edit': True}"
                            />
                            <field name="can_download" invisible="1" />
                            <field name="can_manage_download" invisible="1" />
                            <field
                                name="is_downloadable"
                                widget="boolean_toggle"
                                readonly="not can_manage_download"
                            />
                        </group>
                    </group>
                    <group>
                        <field name="storage_id_save_type" invisible="True" />
                        <field
                            name="res_model"
                            readonly="True"
                            invisible="storage_id_save_type != 'attachment'"
                        />
                        <field
                            name="res_id"
                            readonly="True"
                            invisible="storage_id_save_type != 'attachment'"
                        />
                        <field
                            name="record_ref"
                            invisible="storage_id_save_type != 'attachment'"
                        />
                    </group>
                    <notebook>
                        <page name="page_meta" string="Meta Information">
                            <group>
                                <group>
                                    <field name="create_date" readonly="1" />
                                    <field name="create_uid" readonly="1" />
                                </group>
                                <group>
                                    <field name="write_date" readonly="1" />
                                    <field name="write_uid" readonly="1" />
                                </group>
                            </group>
                        </page>
                        <page name="page_access" string="Access Information">
                            <group>
                                <group>
                                    <field name="permission_write" readonly="1" />
                                    <field name="permission_unlink" readonly="1" />
                                </group>
                                <group>
                                    <field name="is_lock_editor" invisible="1" />
                                    <field name="is_locked" invisible="1" />
                                    <field name="locked_by" />
                                </group>
                            </group>
                        </page>
                        <page
                            name="page_technical"
                            string="Technical Information"
                            invisible="1"
                            groups="dms.group_dms_manager,base.group_no_one"
                        >
                            <group name="technical">
                                <group name="technical_left" />
                                <group name="technical_right" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="action_dms_file" model="ir.actions.act_window">
        <field name="name">Files</field>
        <field name="res_model">dms.file</field>
        <field name="view_mode">kanban,list,graph,pivot,form</field>
        <field name="domain">[("is_hidden", "=", False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new File.
            </p>
            <p>
                Files are used to save content directly in Odoo.
            </p>
        </field>
    </record>
    <!-- Base action to be called when a file selector is to be used !-->
    <record id="action_dms_file_wizard_selector" model="ir.actions.act_window">
        <field name="name">Files</field>
        <field name="res_model">dms.file</field>
        <field name="target">new</field>
        <field name="view_mode">kanban</field>
        <field name="context">{'create': False}</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),(0, 0, {'view_mode': 'kanban', 'view_id': ref('view_dms_file_kanban_wizard_selection')})]"
        />
    </record>
    <record id="search_dms_file_migration" model="ir.ui.view">
        <field name="name">dms_file.search</field>
        <field name="model">dms.file</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="[('name','ilike',self)]" />
                <group>
                    <filter
                        name="group_storage"
                        string="Storage"
                        domain="[]"
                        context="{'group_by':'storage_id'}"
                    />
                </group>
                <searchpanel>
                    <field
                        name="directory_id"
                        icon="fa-folder"
                        limit="0"
                        enable_counters="1"
                    />
                    <field
                        name="category_id"
                        icon="fa-users"
                        limit="0"
                        enable_counters="1"
                    />
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="view_dms_file_migration_tree" model="ir.ui.view">
        <field name="name">dms_file.list</field>
        <field name="model">dms.file</field>
        <field name="arch" type="xml">
            <list
                decoration-muted="(is_locked and not is_lock_editor)"
                create="0"
                delete="0"
            >
                <field name="is_locked" column_invisible="1" />
                <field name="is_lock_editor" column_invisible="1" />
                <field name="name" />
                <field name="write_date" />
                <field name="human_size" string="Size" />
                <field name="mimetype" />
                <field name="storage_id" />
                <field name="migration" />
            </list>
        </field>
    </record>
    <record id="action_dms_file_migration" model="ir.actions.act_window">
        <field name="name">Files</field>
        <field name="res_model">dms.file</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="search_dms_file_migration" />
        <field
            name="domain"
        >[('require_migration', '=', True), '|', ('active', '=', False), ('active', '!=', False)]
        </field>
        <field name="context">{'search_default_group_storage': 1}</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_dms_file_migration_tree')})]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new File.
            </p>
            <p>
                Files are used to save content directly in Odoo.
            </p>
        </field>
    </record>
    <record id="view_dms_file_new_form" model="ir.ui.view">
        <field name="name">dms_file.form</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="view_dms_file_form" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet//div[hasclass('oe_button_box')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <form position="inside">
                <footer>
                    <button
                        class="btn btn-primary"
                        type="object"
                        string="Create"
                        name="action_save_onboarding_file_step"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_dms_file_new" model="ir.actions.act_window">
        <field name="name">New Root Directory</field>
        <field name="res_model">dms.file</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_dms_file_new_form" />
    </record>
    <record id="action_wizard_dms_file_move" model="ir.actions.server">
        <field name="name">Move</field>
        <field name="model_id" ref="dms.model_dms_file" />
        <field name="binding_model_id" ref="dms.model_dms_file" />
        <field name="group_ids" eval="[(4, ref('dms.group_dms_user'))]" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = model.action_wizard_dms_file_move()
        </field>
    </record>

    <!-- POPUP XEM TRƯỚC TÀI LIỆU (MODAL 95VW) -->
    <record id="view_dms_file_preview_modal" model="ir.ui.view">
        <field name="name">dms.file.preview.modal</field>
        <field name="model">dms.file</field>
        <field name="arch" type="xml">
            <form string="Xem trước tài liệu" class="o_dms_preview_box">
                <field name="can_download" invisible="1"/>
                <field name="preview_html" widget="html" nolabel="1" readonly="1" class="d-block w-100 m-0 p-0"/>
                <footer>
                    <button name="action_download_file" type="object" string="Tải về" class="btn-outline-primary" invisible="not can_download"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- SERVER ACTION XEM TRƯỚC TÀI LIỆU TRONG MENU ACTION -->
    <record id="action_dms_file_preview_server" model="ir.actions.server">
        <field name="name">Xem trước tài liệu</field>
        <field name="model_id" ref="dms.model_dms_file"/>
        <field name="binding_model_id" ref="dms.model_dms_file"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
if record:
    action = record.action_preview_file()
elif records:
    action = records[0].action_preview_file()
        </field>
    </record>

    <!-- SERVER ACTIONS CHO PHÉP / KHÓA TẢI VỀ HÀNG LOẠT -->
    <record id="action_dms_file_bulk_allow_download" model="ir.actions.server">
        <field name="name">Cho phép tải về</field>
        <field name="model_id" ref="dms.model_dms_file"/>
        <field name="binding_model_id" ref="dms.model_dms_file"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('dms.group_dms_user'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_bulk_allow_download()</field>
    </record>

    <record id="action_dms_file_bulk_disallow_download" model="ir.actions.server">
        <field name="name">Khóa tải về</field>
        <field name="model_id" ref="dms.model_dms_file"/>
        <field name="binding_model_id" ref="dms.model_dms_file"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('dms.group_dms_user'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_bulk_disallow_download()</field>
    </record>
</odoo>
