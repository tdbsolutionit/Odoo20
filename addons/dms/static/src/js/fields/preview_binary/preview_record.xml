<templates id="template" xml:space="preserve">
    <t
        t-name="dms.FilePreviewField"
        t-inherit="web.BinaryField"
        t-inherit-mode="primary"
    >
        <xpath expr="//div[hasclass('d-inline-flex')]" position="inside">
            <t t-if="props.value or props.record.data.content">
                <button
                    class="btn btn-secondary fa fa-search preview_file"
                    data-tooltip="Xem trước tài liệu"
                    aria-label="Xem trước tài liệu"
                    t-on-click="() => this.onFilePreview()"
                />
            </t>
        </xpath>
    </t>
</templates>
