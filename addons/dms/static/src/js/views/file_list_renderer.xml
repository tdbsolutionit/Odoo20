<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!--
        Add drag-drop zone before the list renderer area.
        o_list_renderer still exists in Odoo 20.
    -->
    <t t-name="dms.ListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_list_renderer')]" position="before">
            <div t-if="this.dragState?.showDragZone" class="o_dropzone">
                <i class="fa fa-cloud-upload fa-10x" />
            </div>
        </xpath>
    </t>

    <!--
        web.ListView.Buttons in Odoo 20 has no <div class="o_list_buttons"> wrapper.
        Add upload buttons after the existing "New" button.
    -->
    <t
        t-name="dms.ListButtons"
        t-inherit="web.ListView.Buttons"
        t-inherit-mode="primary"
    >
        <xpath expr="//button[hasclass('o_list_button_add')]" position="after">
            <t t-if="this.canCreate">
                <button
                    type="button"
                    class="d-none d-md-inline o_button_upload_expense btn btn-primary mx-1"
                    t-on-click.prevent="() => this.uploadDocument()"
                >
                    Upload
                </button>
                <button
                    type="button"
                    class="d-inline d-md-none o_button_upload_expense btn btn-primary mx-1"
                    t-on-click.prevent="() => this.uploadDocument()"
                >
                    Scan
                </button>
                <input
                    type="file"
                    name="ufile"
                    class="d-none"
                    t-ref="this.fileInput"
                    multiple="1"
                    accept="*"
                    t-on-change="(ev) => this.onChangeFileInput(ev)"
                />
            </t>
            <button
                type="button"
                class="btn btn-secondary mx-1"
                t-on-click.prevent="() => this.openDateFilterWizard()"
                title="Lọc tệp tin theo khoảng thời gian (Từ ngày - Đến ngày)"
            >
                <i class="fa fa-calendar-check-o me-1" />
                Lọc thời gian
            </button>
        </xpath>
    </t>
</templates>
