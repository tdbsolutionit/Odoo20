<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================================= -->
    <!-- TDB SOLUTION - PHÂN TẦNG LAYER 5: VIEWS VÀ GIAO DIỆN BACKEND PLM       -->
    <!-- Kế thừa giao diện danh sách Engineering Parts (plm_component_base_tree) -->
    <!-- Chuẩn hóa chuỗi gốc tiếng Anh & Tỷ lệ cột co giãn tự động theo màn hình -->
    <!-- ======================================================================= -->

    <record id="plm_component_base_tree_inherit_tdb" model="ir.ui.view">
        <field name="name">product.product.tree.plm.tdb.custom</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="plm.plm_component_base_tree"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <!-- Thêm class nhận diện riêng cho bảng danh sách linh kiện PLM -->
            <xpath expr="//list" position="attributes">
                <attribute name="class">tdb_plm_list_view</attribute>
                <attribute name="string">Engineering Parts</attribute>
            </xpath>

            <!-- Cột 1: Hình ảnh -->
            <xpath expr="//field[@name='image_1920']" position="attributes">
                <attribute name="string">Image</attribute>
                <attribute name="class">text-center</attribute>
                <attribute name="width">65px</attribute>
                <attribute name="optional">show</attribute>
            </xpath>

            <!-- Cột 2: Tên linh kiện -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Name</attribute>
                <attribute name="width">[120,240]</attribute>
            </xpath>

            <!-- Cột Cấu hình: Ẩn mặc định, hiển thị khi người dùng cần -->
            <xpath expr="//field[@name='configuration_name']" position="attributes">
                <attribute name="string">Configuration Name</attribute>
                <attribute name="optional">hide</attribute>
                <attribute name="width">[100,150]</attribute>
            </xpath>

            <!-- Cột 3: Mã kỹ thuật -->
            <xpath expr="//field[@name='engineering_code']" position="attributes">
                <attribute name="string">Engineering Code</attribute>
                <attribute name="width">[95,130]</attribute>
            </xpath>

            <!-- Cột 4: Tham chiếu nội bộ -->
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="string">Internal Reference</attribute>
                <attribute name="width">[110,150]</attribute>
            </xpath>

            <!-- Cột 5: Engineering Revision -->
            <xpath expr="//field[@name='engineering_revision']" position="attributes">
                <attribute name="string">Revision</attribute>
                <attribute name="class">text-center</attribute>
                <attribute name="width">70px</attribute>
            </xpath>

            <!-- Cột 6: Engineering Status -->
            <xpath expr="//field[@name='engineering_state']" position="attributes">
                <attribute name="string">Engineering Status</attribute>
                <attribute name="class">text-center</attribute>
                <attribute name="width">115px</attribute>
            </xpath>

            <!-- Cột 7: Description -->
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="string">Description</attribute>
                <attribute name="invisible">0</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="width">[85,160]</attribute>
            </xpath>

            <!-- Cột 8: Writable -->
            <xpath expr="//field[@name='engineering_writable']" position="attributes">
                <attribute name="string">Writable</attribute>
                <attribute name="invisible">0</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="class">text-center</attribute>
                <attribute name="width">115px</attribute>
            </xpath>

            <!-- Cột 9: CAD Raw Material -->
            <xpath expr="//field[@name='engineering_material']" position="attributes">
                <attribute name="string">CAD Raw Material</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="width">[95,135]</attribute>
            </xpath>

            <!-- Cột 10: CAD Surface Finishing -->
            <xpath expr="//field[@name='engineering_surface']" position="attributes">
                <attribute name="string">CAD Surface Finishing</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="width">[95,135]</attribute>
            </xpath>

            <!-- Cột 11: Linked Documents -->
            <xpath expr="//field[@name='linkeddocuments']" position="attributes">
                <attribute name="string">Linked Documents</attribute>
                <attribute name="invisible">0</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="widget">many2many_tags</attribute>
                <attribute name="width">[105,150]</attribute>
            </xpath>

            <!-- Cột 12: Checked-Out By -->
            <xpath expr="//field[@name='document_checkout_user_ids']" position="attributes">
                <attribute name="string">Checked-Out By</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="widget">many2many_tags</attribute>
                <attribute name="width">[115,160]</attribute>
            </xpath>
        </field>
    </record>

    <!-- Kế thừa giao diện tìm kiếm PLM Component Search để dịch bộ lọc "Latest" sang tiếng Việt -->
    <record id="plm_component_base_search_inherit_tdb" model="ir.ui.view">
        <field name="name">product.product.search.plm.tdb.custom</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="plm.plm_component_base_search"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='latest']" position="attributes">
                <attribute name="string">Latest</attribute>
            </xpath>
            <xpath expr="//filter[@name='checked_out']" position="attributes">
                <attribute name="string">Checked Out</attribute>
            </xpath>
            <xpath expr="//filter[@name='string']" position="attributes">
                <attribute name="string">Confirmed</attribute>
            </xpath>
            <xpath expr="//filter[@name='released']" position="attributes">
                <attribute name="string">Released</attribute>
            </xpath>
            <xpath expr="//filter[@name='obsolated']" position="attributes">
                <attribute name="string">Obsoleted</attribute>
            </xpath>
        </field>
    </record>

    <!-- Cập nhật tiêu đề Action cửa sổ phân hệ PLM -->
    <record id="plm.action_plm_component_base" model="ir.actions.act_window">
        <field name="name">Engineering Parts</field>
    </record>

    <record id="plm.action_plm_component_base_cad_form" model="ir.actions.act_window">
        <field name="name">Engineering Parts</field>
    </record>
</odoo>
