<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================================= -->
    <!-- TDB SOLUTION - PHÂN TẦNG LAYER 5: VIEWS VÀ GIAO DIỆN BACKEND PLM       -->
    <!-- Quản lý Document Lock: Kiến trúc Người giữ Key (Key Holder Architecture)-->
    <!-- & Chuyển giao Key cưỡng chế (Force Unlock) cho Quản trị viên            -->
    <!-- ======================================================================= -->

    <!-- 1. Danh sách Documents (List View): Người giữ Key, Trạng thái & Nút chuyển giao Key -->
    <record id="plm_ir_attachment_list_inherit_tdb" model="ir.ui.view">
        <field name="name">ir.attachment.list.plm.tdb.custom</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="plm.ir_attachment_list"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <!-- Thêm class nhận diện chung bảng PLM -->
            <xpath expr="//list" position="attributes">
                <attribute name="class">tdb_plm_list_view</attribute>
                <attribute name="string">Documents</attribute>
            </xpath>

            <!-- Preview -->
            <xpath expr="//field[@name='preview']" position="attributes">
                <attribute name="string">Preview</attribute>
                <attribute name="class">text-center</attribute>
                <attribute name="width">75px</attribute>
            </xpath>

            <!-- Engineering Revision -->
            <xpath expr="//field[@name='engineering_revision']" position="attributes">
                <attribute name="string">Revision</attribute>
                <attribute name="class">text-center</attribute>
                <attribute name="width">95px</attribute>
            </xpath>

            <!-- Engineering Status -->
            <xpath expr="//field[@name='engineering_state']" position="attributes">
                <attribute name="string">Engineering Status</attribute>
                <attribute name="class">text-center</attribute>
                <attribute name="width">140px</attribute>
            </xpath>

            <!-- Người giữ Key & Nút chuyển giao Key -->
            <xpath expr="//field[@name='checkout_user']" position="replace">
                <field name="is_checkout" column_invisible="1"/>
                <field name="key_holder_id" string="Người giữ Key" widget="many2one_avatar_user" optional="show"/>
                <field name="lock_state"
                       widget="badge"
                       decoration-danger="lock_state == 'locked'"
                       decoration-success="lock_state == 'unlocked'"
                       string="Trạng thái"
                       optional="show"/>
                <button name="action_open_transfer_key_wizard"
                        type="object"
                        string="Chuyển giao Key"
                        class="btn btn-sm btn-outline-danger"
                        groups="plm.group_plm_admin"/>
            </xpath>
        </field>
    </record>

    <!-- 2. Form View Documents: Thêm Banner Người giữ Key & Header Actions -->
    <record id="plm_ir_attachment_form_inherit_tdb" model="ir.ui.view">
        <field name="name">ir.attachment.form.plm.tdb.custom</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="plm.view_attachment_form_plm_hinerit"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <!-- Thêm các nút thao tác trên Header -->
            <xpath expr="//header" position="inside">
                <field name="is_key_holder" invisible="1"/>
                <field name="is_checkout" invisible="1"/>

                <!-- Nút cho Admin: Cưỡng chế chuyển giao Key (Force Unlock) -->
                <button name="action_open_transfer_key_wizard"
                        type="object"
                        string="Chuyển giao Key (Force Unlock)"
                        class="btn-danger"
                        groups="plm.group_plm_admin"/>

                <!-- Nút cho Kỹ sư giữ Key (khi không phải Admin): Bàn giao Key -->
                <button name="action_open_transfer_key_wizard"
                        type="object"
                        string="Bàn giao Key"
                        class="btn-warning"
                        invisible="not is_key_holder"
                        groups="!plm.group_plm_admin"/>

                <!-- Nút Check-out: Mọi kỹ sư đều có thể bấm khi chưa check-out -->
                <button name="action_web_checkout"
                        type="object"
                        string="Check-out"
                        class="btn-secondary"
                        invisible="is_checkout == True"/>

                <!-- Nút Check-in: Chỉ hiển thị cho người đang Check-out VÀ đang giữ Key -->
                <button name="action_web_checkin"
                        type="object"
                        string="Check-in"
                        class="btn-primary"
                        invisible="is_checkout == False or not is_key_holder"/>
            </xpath>

            <!-- Banner thông tin Người giữ Key -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info d-flex align-items-center mb-0 py-2 justify-content-between"
                     role="alert"
                     invisible="not key_holder_id">
                    <div>
                        <span>Người giữ Key Check-in: </span><field name="key_holder_id" class="fw-bold"/>
                        <span class="text-muted ms-2">(Kỹ sư giữ Key được quyền Check-in cập nhật bản vẽ)</span>
                    </div>
                    <div>
                        <span class="badge bg-success" invisible="not is_key_holder">Bạn đang giữ Key</span>
                        <span class="badge bg-secondary" invisible="is_key_holder">Chế độ tham chiếu</span>
                    </div>
                </div>
                <div class="alert alert-warning d-flex align-items-center mb-0 py-2 justify-content-between"
                     role="alert"
                     invisible="key_holder_id">
                    <div>
                        <span>Tài liệu đang ở trạng thái </span><span class="fw-bold">Nhả Key tự do</span>
                        <span class="text-muted ms-2">(Kỹ sư Check-out kế tiếp sẽ tự động nhận quyền giữ Key)</span>
                    </div>
                    <div>
                        <span class="badge bg-warning text-dark">Chờ tiếp quản Key</span>
                    </div>
                </div>
            </xpath>

            <!-- Bổ sung Người giữ Key vào nhóm thông tin PLM INFOS -->
            <xpath expr="//group[@name='main_doc_info']" position="inside">
                <field name="key_holder_id" readonly="1" widget="many2one_avatar_user" string="Người giữ Key"/>
            </xpath>

            <!-- Stat button đếm và xem lịch sử phiên bản tệp & quan hệ tham chiếu -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_file_history"
                        type="object"
                        class="oe_stat_button"
                        icon="history"
                        invisible="history_count == 0">
                    <field name="history_count" widget="statinfo" string="Lịch sử file"/>
                </button>
                <button name="action_view_child_documents"
                        type="object"
                        class="oe_stat_button"
                        icon="account_tree"
                        invisible="child_document_count == 0">
                    <field name="child_document_count" widget="statinfo" string="File con"/>
                </button>
                <button name="action_view_where_used_documents"
                        type="object"
                        class="oe_stat_button"
                        icon="share"
                        invisible="parent_document_count == 0">
                    <field name="parent_document_count" widget="statinfo" string="Nơi dùng"/>
                </button>
            </xpath>

            <!-- Tab Lịch sử phiên bản tệp trong Notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Lịch sử phiên bản" name="file_history">
                    <field name="history_ids" readonly="1">
                        <list string="Lịch sử phiên bản tệp" default_order="version_number desc" create="0" delete="0">
                            <field name="version_number" column_invisible="1"/>
                            <field name="version" string="Phiên bản" width="90px"/>
                            <field name="file_name" string="Tên file"/>
                            <field name="file_size_display" string="Dung lượng" width="110px"/>
                            <field name="user_id" string="Người thực hiện" widget="many2one_avatar_user" width="160px"/>
                            <field name="create_date" string="Thời điểm lưu" width="160px"/>
                            <field name="description" string="Ghi chú"/>
                            <button name="action_restore_version"
                                    type="object"
                                    string="Khôi phục"
                                    icon="history"
                                    class="btn btn-sm btn-link text-warning"
                                    title="Khôi phục tài liệu về phiên bản này"
                                    confirm="Bạn có chắc chắn muốn KHÔI PHỤC tài liệu về phiên bản này không? Hệ thống sẽ tạo một phiên bản mới mang nội dung của phiên bản được chọn."/>
                            <button name="action_download_file"
                                    type="object"
                                    string="Tải về"
                                    class="btn btn-sm btn-secondary"
                                    title="Tải snapshot phiên bản này"/>
                        </list>
                    </field>
                </page>

                <!-- Tab File liên quan (References) & Where Used (Task 5) -->
                <page string="File liên quan (References)" name="related_documents">
                    <div class="pt-3 pb-2 mb-4">
                        <separator string="Danh sách chi tiết con (Components / References)"/>
                        <field name="child_relation_ids">
                            <list string="Chi tiết con liên quan" editable="bottom">
                                <field name="child_preview" widget="image" options="{'size': [36, 36]}" class="oe_avatar" string="Preview" width="55px" readonly="1"/>
                                <field name="child_id" string="Tài liệu con" domain="[('is_plm', '=', True), ('id', '!=', parent.id)]" required="1"/>
                                <field name="child_engineering_code" string="Mã kỹ thuật" width="130px" optional="show" readonly="1"/>
                                <field name="child_revision" string="Phiên bản" width="80px" readonly="1"/>
                                <field name="child_state"
                                       string="Trạng thái kỹ thuật"
                                       widget="badge"
                                       decoration-info="child_state == 'draft'"
                                       decoration-primary="child_state == 'confirmed'"
                                       decoration-success="child_state == 'released'"
                                       decoration-warning="child_state == 'undermodify'"
                                       decoration-danger="child_state == 'obsoleted'"
                                       width="150px"
                                       readonly="1"/>
                                <field name="child_lock_state"
                                       string="Trạng thái khóa"
                                       widget="badge"
                                       decoration-danger="child_lock_state == 'locked'"
                                       decoration-success="child_lock_state == 'unlocked'"
                                       width="130px"
                                       readonly="1"/>
                                <field name="child_key_holder_id"
                                       string="Người giữ Key"
                                       widget="many2one_avatar_user"
                                       width="150px"
                                       optional="show"
                                       readonly="1"/>
                                <field name="cad_configuration" string="Cấu hình CAD"/>
                                <field name="link_kind" string="Loại liên kết" width="110px"/>
                                <button name="action_open_child_document"
                                        type="object"
                                        icon="open_in_new"
                                        title="Mở chi tiết tài liệu con"
                                        class="btn btn-sm btn-link"/>
                            </list>
                        </field>
                    </div>
                    <div class="pt-4 pb-2">
                        <separator string="Nơi sử dụng (Where Used)"/>
                        <field name="parent_relation_ids" readonly="1">
                            <list string="Nơi sử dụng (Where Used)" create="0" delete="0">
                                <field name="parent_preview" widget="image" options="{'size': [36, 36]}" class="oe_avatar" string="Preview" width="55px"/>
                                <field name="parent_id" string="Assembly cha" readonly="1"/>
                                <field name="parent_engineering_code" string="Mã kỹ thuật" width="130px" optional="show" readonly="1"/>
                                <field name="parent_revision" string="Phiên bản" width="80px" readonly="1"/>
                                <field name="parent_state"
                                       string="Trạng thái kỹ thuật"
                                       widget="badge"
                                       decoration-info="parent_state == 'draft'"
                                       decoration-primary="parent_state == 'confirmed'"
                                       decoration-success="parent_state == 'released'"
                                       decoration-warning="parent_state == 'undermodify'"
                                       decoration-danger="parent_state == 'obsoleted'"
                                       width="150px"
                                       readonly="1"/>
                                <field name="parent_lock_state"
                                       string="Trạng thái khóa"
                                       widget="badge"
                                       decoration-danger="parent_lock_state == 'locked'"
                                       decoration-success="parent_lock_state == 'unlocked'"
                                       width="130px"
                                       readonly="1"/>
                                <field name="parent_key_holder_id"
                                       string="Người giữ Key"
                                       widget="many2one_avatar_user"
                                       width="150px"
                                       optional="show"
                                       readonly="1"/>
                                <field name="cad_configuration" string="Cấu hình CAD" readonly="1"/>
                                <field name="link_kind" string="Loại liên kết" width="110px" readonly="1"/>
                                <button name="action_open_parent_document"
                                        type="object"
                                        icon="open_in_new"
                                        title="Mở chi tiết Assembly cha"
                                        class="btn btn-sm btn-link"/>
                            </list>
                        </field>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- 3. Kế thừa danh sách Checked-Out Documents: Thêm nút Chuyển giao Key -->
    <record id="plm_checkout_list_inherit_tdb" model="ir.ui.view">
        <field name="name">plm.checkout.list.tdb</field>
        <field name="model">plm.checkout</field>
        <field name="inherit_id" ref="plm.plm_checkout_list"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_date']" position="after">
                <button name="action_force_unlock"
                        type="object"
                        string="Chuyển giao Key"
                        class="btn btn-sm btn-outline-danger"
                        groups="plm.group_plm_admin"/>
            </xpath>
        </field>
    </record>

    <!-- 4. Kế thừa Form View Checked-Out Documents: Thêm Header & nút Chuyển giao Key -->
    <record id="plm_checkout_form_inherit_tdb" model="ir.ui.view">
        <field name="name">plm.checkout.form.tdb</field>
        <field name="model">plm.checkout</field>
        <field name="inherit_id" ref="plm.view_plm_checkout_form"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_force_unlock"
                            type="object"
                            string="Chuyển giao Key (Force Unlock)"
                            class="btn-danger"
                            groups="plm.group_plm_admin"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- 5. Danh sách plm.document.history (Tree / List View) -->
    <record id="view_plm_document_history_list" model="ir.ui.view">
        <field name="name">plm.document.history.list</field>
        <field name="model">plm.document.history</field>
        <field name="arch" type="xml">
            <list string="Lịch sử phiên bản tệp" default_order="version_number desc" create="0" delete="1">
                <field name="version_number" column_invisible="1"/>
                <field name="document_id" string="Tài liệu"/>
                <field name="version" string="Phiên bản" width="90px"/>
                <field name="file_name" string="Tên file"/>
                <field name="file_size_display" string="Dung lượng" width="110px"/>
                <field name="user_id" string="Người thực hiện" widget="many2one_avatar_user" width="160px"/>
                <field name="create_date" string="Thời điểm lưu" width="160px"/>
                <field name="description" string="Ghi chú"/>
                <button name="action_restore_version"
                        type="object"
                        string="Khôi phục"
                        icon="history"
                        class="btn btn-sm btn-link text-warning"
                        title="Khôi phục tài liệu về phiên bản này"
                        confirm="Bạn có chắc chắn muốn KHÔI PHỤC tài liệu về phiên bản này không? Hệ thống sẽ tạo một phiên bản mới mang nội dung của phiên bản được chọn."/>
                <button name="action_download_file"
                        type="object"
                        string="Tải về"
                        class="btn btn-sm btn-secondary"
                        title="Tải snapshot phiên bản này"/>
            </list>
        </field>
    </record>

    <!-- 6. Form View plm.document.history -->
    <record id="view_plm_document_history_form" model="ir.ui.view">
        <field name="name">plm.document.history.form</field>
        <field name="model">plm.document.history</field>
        <field name="arch" type="xml">
            <form string="Chi tiết phiên bản lịch sử" create="0" delete="1">
                <header>
                    <button name="action_restore_version"
                            type="object"
                            string="Khôi phục về phiên bản này"
                            class="btn-warning"
                            confirm="Bạn có chắc chắn muốn KHÔI PHỤC tài liệu về phiên bản này không? Hệ thống sẽ tạo một phiên bản mới mang nội dung của phiên bản được chọn."/>
                    <button name="action_download_file"
                            type="object"
                            string="Tải file snapshot về máy"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Thông tin phiên bản">
                            <field name="document_id" readonly="1"/>
                            <field name="version" readonly="1"/>
                            <field name="file_name" readonly="1"/>
                            <field name="file_size_display" readonly="1"/>
                        </group>
                        <group string="Nhật ký lưu">
                            <field name="user_id" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="datas" filename="file_name" widget="binary" readonly="1"/>
                        </group>
                    </group>
                    <group string="Ghi chú thay đổi">
                        <field name="description" placeholder="Ghi chú lý do cập nhật hoặc thay đổi phiên bản..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Cập nhật Action Documents: Gỡ bỏ bộ lọc mặc định 'Must Update from CAD' để hiển thị toàn bộ tài liệu ngay khi mở menu -->
    <record id="plm.plm_action_document_form" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="context">{"odooPLM": True}</field>
    </record>
</odoo>
