<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View: CAD Desktop Access Tokens -->
    <record id="plm_desktop_token_view_list" model="ir.ui.view">
        <field name="name">plm.desktop.token.list</field>
        <field name="model">plm.desktop.token</field>
        <field name="arch" type="xml">
            <list string="Desktop Access Tokens"
                  decoration-success="is_active"
                  decoration-danger="not is_active"
                  decoration-muted="is_revoked">
                <field name="user_id" widget="many2one_avatar_user" string="CAD Engineer"/>
                <field name="machine_name" string="Workstation Name"/>
                <field name="client_ip" string="Client IP"/>
                <field name="cad_version" string="CAD Version"/>
                <field name="issued_at" string="Issued Date"/>
                <field name="expires_at" string="Expiration Date"/>
                <field name="last_used_date" string="Last Access Date"/>
                <field name="is_active" widget="boolean_badge" string="Active"/>
                <button name="action_revoke"
                        type="object"
                        string="Revoke Access"
                        class="btn-danger btn-sm"
                        icon="fa-ban"
                        invisible="not is_active"
                        confirm="Are you sure you want to revoke access for this device? The SolidWorks CAD workstation will be disconnected immediately!"/>
                <button name="action_unrevoke"
                        type="object"
                        string="Restore"
                        class="btn-secondary btn-sm"
                        icon="fa-refresh"
                        invisible="is_active"/>
            </list>
        </field>
    </record>

    <!-- Form View: CAD Desktop Access Token -->
    <record id="plm_desktop_token_view_form" model="ir.ui.view">
        <field name="name">plm.desktop.token.form</field>
        <field name="model">plm.desktop.token</field>
        <field name="arch" type="xml">
            <form string="Desktop Access Token">
                <header>
                    <button name="action_revoke"
                            type="object"
                            string="Revoke Access"
                            class="btn-danger"
                            icon="fa-ban"
                            invisible="not is_active"
                            confirm="Are you sure you want to disconnect and revoke this CAD workstation session?"/>
                    <button name="action_unrevoke"
                            type="object"
                            string="Restore"
                            class="btn-secondary"
                            icon="fa-refresh"
                            invisible="is_active"/>
                    <field name="is_active" widget="boolean_badge"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="machine_name" string="CAD Workstation Name"/>
                        <h1>
                            <field name="machine_name" placeholder="e.g. WS-CAD-01"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Device &amp; Engineer Info">
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="machine_uuid"/>
                            <field name="cad_version"/>
                            <field name="client_ip"/>
                        </group>
                        <group string="Validity &amp; Status">
                            <field name="issued_at"/>
                            <field name="expires_at"/>
                            <field name="last_used_date"/>
                            <field name="is_revoked"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Technical Details &amp; Session" groups="base.group_no_one,base.group_system">
                            <group>
                                <field name="name" string="Token Hash"/>
                                <field name="session_id" string="Session SID"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="plm_desktop_token_view_search" model="ir.ui.view">
        <field name="name">plm.desktop.token.search</field>
        <field name="model">plm.desktop.token</field>
        <field name="arch" type="xml">
            <search string="Search Desktop Tokens">
                <field name="user_id"/>
                <field name="machine_name"/>
                <field name="client_ip"/>
                <field name="cad_version"/>
                <filter name="filter_active" string="Active" domain="[('is_active', '=', True)]"/>
                <filter name="filter_revoked" string="Revoked" domain="[('is_revoked', '=', True)]"/>
                <group>
                    <filter name="group_user" string="Engineer" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter name="group_cad" string="CAD Version" domain="[]" context="{'group_by': 'cad_version'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Desktop Tokens -->
    <record id="action_plm_desktop_token" model="ir.actions.act_window">
        <field name="name">Desktop Access Tokens</field>
        <field name="res_model">plm.desktop.token</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No CAD devices connected yet.
            </p>
            <p>
                When engineers log in from the SolidWorks CAD Add-in (OdooPLM), the system automatically issues a 180-day session and records the workstation details here.
            </p>
        </field>
    </record>

    <!-- Menuitem: PLM ➔ Configuration ➔ Desktop Access Tokens -->
    <menuitem id="menu_plm_desktop_token"
              name="Desktop Access Tokens"
              parent="plm.plm_menu_dictionaries"
              action="action_plm_desktop_token"
              sequence="90"
              groups="base.group_user"/>
</odoo>
