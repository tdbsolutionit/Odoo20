<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View: CAD Desktop Access Tokens -->
    <record id="plm_desktop_token_view_list" model="ir.ui.view">
        <field name="name">plm.desktop.token.list</field>
        <field name="model">plm.desktop.token</field>
        <field name="arch" type="xml">
            <list string="Desktop Access Tokens"
                  decoration-success="state == 'active'"
                  decoration-danger="state == 'revoked'"
                  decoration-warning="state == 'expired'">
                <field name="user_id" widget="many2one_avatar_user" string="Kỹ sư CAD"/>
                <field name="machine_name" string="Tên máy trạm"/>
                <field name="client_ip" string="Địa chỉ IP máy trạm"/>
                <field name="cad_version" string="Phiên bản CAD"/>
                <field name="issued_at" string="Ngày cấp"/>
                <field name="expires_at" string="Hạn chót hiệu lực"/>
                <field name="last_used_date" string="Lần truy cập cuối"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'revoked'"
                       decoration-warning="state == 'expired'"
                       string="Trạng thái"/>
                <button name="action_revoke"
                        type="object"
                        string="Thu hồi quyền"
                        class="btn-danger btn-sm"
                        groups="tdb_plm_custom.group_plm_desktop_token_boss"
                        invisible="state != 'active'"
                        confirm="Bạn có chắc chắn muốn thu hồi quyền truy cập của thiết bị CAD này? Máy trạm sẽ bị ngắt kết nối ngay lập tức!"/>
                <button name="action_set_expired_test"
                        type="object"
                        string="Thử hết hạn"
                        class="btn-warning btn-sm"
                        groups="tdb_plm_custom.group_plm_desktop_token_boss"
                        invisible="state != 'active'"
                        confirm="Chuyển token sang trạng thái HẾT HẠN để kiểm thử việc chặn SolidWorks khi hết hạn 180 ngày?"/>
                <button name="action_unrevoke"
                        type="object"
                        string="Khôi phục"
                        class="btn-success btn-sm"
                        groups="tdb_plm_custom.group_plm_desktop_token_boss"
                        invisible="state != 'revoked'"/>
                <button name="action_renew_180_days"
                        type="object"
                        string="Gia hạn 180 ngày"
                        class="btn-primary btn-sm"
                        groups="tdb_plm_custom.group_plm_desktop_token_boss"
                        invisible="state != 'expired'"/>
            </list>
        </field>
    </record>

    <!-- Form View: CAD Desktop Access Token -->
    <record id="plm_desktop_token_view_form" model="ir.ui.view">
        <field name="name">plm.desktop.token.form</field>
        <field name="model">plm.desktop.token</field>
        <field name="arch" type="xml">
            <form string="Desktop Access Token">
                <header>
                    <button name="action_revoke"
                            type="object"
                            string="Thu hồi quyền"
                            class="btn-danger"
                            groups="tdb_plm_custom.group_plm_desktop_token_boss"
                            invisible="state != 'active'"
                            confirm="Bạn có chắc chắn muốn thu hồi và ngắt kết nối máy trạm CAD này?"/>
                    <button name="action_set_expired_test"
                            type="object"
                            string="Thử hết hạn (Test)"
                            class="btn-warning"
                            groups="tdb_plm_custom.group_plm_desktop_token_boss"
                            invisible="state != 'active'"
                            confirm="Chuyển token sang trạng thái HẾT HẠN để kiểm thử việc chặn SolidWorks khi hết hạn 180 ngày?"/>
                    <button name="action_unrevoke"
                            type="object"
                            string="Khôi phục quyền truy cập"
                            class="btn-success"
                            groups="tdb_plm_custom.group_plm_desktop_token_boss"
                            invisible="state != 'revoked'"/>
                    <button name="action_renew_180_days"
                            type="object"
                            string="Gia hạn 180 ngày"
                            class="btn-primary"
                            groups="tdb_plm_custom.group_plm_desktop_token_boss"
                            invisible="state != 'expired'"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'active'"
                           decoration-danger="state == 'revoked'"
                           decoration-warning="state == 'expired'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="machine_name" string="Tên máy trạm CAD"/>
                        <h1>
                            <field name="machine_name" placeholder="VD: WS-CAD-01"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Thông tin Thiết bị &amp; Kỹ sư">
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="machine_uuid"/>
                            <field name="cad_version"/>
                            <field name="client_ip"/>
                        </group>
                        <group string="Thời hạn &amp; Trạng thái">
                            <field name="issued_at"/>
                            <field name="expires_at"/>
                            <field name="last_used_date"/>
                            <field name="is_revoked"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Thông số Kỹ thuật &amp; Session" groups="base.group_no_one,base.group_system">
                            <group>
                                <field name="name" string="Token Hash"/>
                                <field name="session_id" string="Session SID"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="plm_desktop_token_view_search" model="ir.ui.view">
        <field name="name">plm.desktop.token.search</field>
        <field name="model">plm.desktop.token</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Desktop Tokens">
                <field name="user_id"/>
                <field name="machine_name"/>
                <field name="client_ip"/>
                <field name="cad_version"/>
                <filter name="filter_active" string="Đang hoạt động" domain="[('state', '=', 'active')]"/>
                <filter name="filter_revoked" string="Đã thu hồi" domain="[('state', '=', 'revoked')]"/>
                <filter name="filter_expired" string="Hết hạn" domain="[('state', '=', 'expired')]"/>
                <group>
                    <filter name="group_user" string="Kỹ sư" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter name="group_cad" string="Phiên bản CAD" domain="[]" context="{'group_by': 'cad_version'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Desktop Tokens (Chỉ dành riêng cho Sếp Admin) -->
    <record id="action_plm_desktop_token" model="ir.actions.act_window">
        <field name="name">Desktop Access Tokens (Quản lý thiết bị CAD)</field>
        <field name="res_model">plm.desktop.token</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(6, 0, [ref('tdb_plm_custom.group_plm_desktop_token_boss')])]"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có thiết bị CAD nào kết nối.
            </p>
            <p>
                Khi kỹ sư đăng nhập từ Add-in SolidWorks / CAD vào Odoo, hệ thống sẽ tự động cấp phiên làm việc 180 ngày và ghi nhận máy trạm tại đây.
            </p>
        </field>
    </record>

    <!-- Menuitem trên Top Bar PLM: Hiển thị trực tiếp cho Sếp Admin, ẩn hoàn toàn với Kỹ sư -->
    <menuitem id="menu_plm_desktop_token_top"
              name="Desktop Access Tokens"
              parent="plm.plm_menu"
              action="action_plm_desktop_token"
              groups="tdb_plm_custom.group_plm_desktop_token_boss"
              sequence="90"/>

    <!-- Menuitem phụ trong PLM ➔ Cấu hình: Chỉ duy nhất Sếp Admin -->
    <menuitem id="menu_plm_desktop_token"
              name="Desktop Access Tokens"
              parent="plm.plm_menu_dictionaries"
              action="action_plm_desktop_token"
              groups="tdb_plm_custom.group_plm_desktop_token_boss"
              sequence="90"/>
</odoo>
