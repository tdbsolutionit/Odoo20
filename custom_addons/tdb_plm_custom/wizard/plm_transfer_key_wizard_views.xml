<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_plm_transfer_key_wizard_form" model="ir.ui.view">
        <field name="name">plm.transfer.key.wizard.form</field>
        <field name="model">plm.transfer.key.wizard</field>
        <field name="arch" type="xml">
            <form string="Chuyển giao &amp; Thu hồi quyền giữ Key">
                <sheet>
                    <div class="alert alert-warning mb-3 py-2" role="alert">
                        Chuyển giao quyền Check-in (giữ Key) cho kỹ sư khác hoặc thu hồi Key để tài liệu trở về trạng thái tự do.
                    </div>
                    <group>
                        <group string="Thông tin tài liệu">
                            <field name="document_id" invisible="1"/>
                            <field name="document_name" string="Tài liệu"/>
                            <field name="current_key_holder_id" string="Kỹ sư đang giữ Key" widget="many2one_avatar_user"/>
                        </group>
                        <group string="Hình thức thực hiện">
                            <field name="transfer_type" widget="radio"/>
                            <field name="new_key_holder_id"
                                   string="Kỹ sư nhận Key mới"
                                   widget="many2one_avatar_user"
                                   options="{'no_create': True, 'no_open': True}"
                                   invisible="transfer_type != 'to_user'"
                                   required="transfer_type == 'to_user'"/>
                            <field name="release_all_checkouts" string="Giải phóng toàn bộ Check-out"/>
                        </group>
                    </group>
                    <group string="Lý do (Không bắt buộc)">
                        <field name="reason" placeholder="Nhập lý do chuyển giao hoặc thu hồi Key (không bắt buộc)..." nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_transfer"
                            string="Xác nhận"
                            type="object"
                            class="btn-danger"/>
                    <button string="Hủy bỏ"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
