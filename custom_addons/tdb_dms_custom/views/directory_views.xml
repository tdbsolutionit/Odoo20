<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kế thừa Form view dms.directory để thêm nút Tạo thư mục con và cờ Thùng Rác -->
    <record id="view_dms_directory_form_inherit_tdb" model="ir.ui.view">
        <field name="name">dms.directory.form.inherit.tdb</field>
        <field name="model">dms.directory</field>
        <field name="inherit_id" ref="dms.view_dms_directory_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_open_create_subfolder_wizard"
                    type="object"
                    string="Tạo thư mục con"
                    class="btn-primary"
                    invisible="is_recycle_bin"
                />
            </xpath>
            <xpath expr="//group[@name='department_security']//group[1]" position="inside">
                <field name="is_recycle_bin" widget="boolean_toggle" groups="base.group_system" readonly="1" invisible="not is_recycle_bin" />
            </xpath>
        </field>
    </record>

    <!-- Kế thừa List view dms.directory -->
    <record id="view_dms_directory_tree_inherit_tdb" model="ir.ui.view">
        <field name="name">dms.directory.list.inherit.tdb</field>
        <field name="model">dms.directory</field>
        <field name="inherit_id" ref="dms.view_dms_directory_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="is_recycle_bin" column_invisible="True" />
                <button
                    name="action_open_create_subfolder_wizard"
                    type="object"
                    string="Tạo thư mục con"
                    title="Tạo thư mục con bên trong thư mục này"
                    invisible="is_recycle_bin"
                />
            </xpath>
        </field>
    </record>

    <!-- Kế thừa Kanban view dms.directory để thêm mục Tạo thư mục con trong menu 3 chấm -->
    <record id="view_dms_directory_kanban_inherit_tdb" model="ir.ui.view">
        <field name="name">dms.directory.kanban.inherit.tdb</field>
        <field name="model">dms.directory</field>
        <field name="inherit_id" ref="dms.view_dms_directory_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_recycle_bin" />
            </xpath>
            <xpath expr="//div[@name='card_menu_view']" position="inside">
                <div role="menuitem" t-if="!record.is_recycle_bin.raw_value">
                    <a name="action_open_create_subfolder_wizard" type="object" class="text-primary">
                        <i class="fa fa-folder-open-o" />
                        Tạo thư mục con
                    </a>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
