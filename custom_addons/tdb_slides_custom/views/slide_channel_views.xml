<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_slide_channel_form_inherit_video_folder" model="ir.ui.view">
        <field name="name">slide.channel.form.inherit.video.folder</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.view_slide_channel_form"/>
        <field name="arch" type="xml">
            <!-- Thêm khu vực Quản lý Thư mục Video ngay dưới tiêu đề khóa học -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <field name="video_folder_path" invisible="1"/>
                <field name="video_folder_disk_display" invisible="1"/>
                <field name="video_folder_id" invisible="1"/>
                <!-- Widget Tải Video & Thư mục trực tiếp từ Máy tính qua File Explorer -->
                <widget name="slide_video_folder_uploader"/>
            </xpath>
        </field>
    </record>

    <!-- Kế thừa Kanban Khóa học: Thêm nút Xóa khóa học trực tiếp trong menu 3 chấm (Hình 2) -->
    <record id="slide_channel_view_kanban_inherit_delete" model="ir.ui.view">
        <field name="name">slide.channel.view.kanban.inherit.delete</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.slide_channel_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="delete">true</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_kanban_slides_card_manage_pane')]" position="inside">
                <a role="menuitem" type="delete" class="dropdown-item text-danger border-top mt-1 pt-1 fw-bold">
                    <i class="oi oi-trash me-1"/>Xóa khóa học
                </a>
            </xpath>
        </field>
    </record>
</odoo>
