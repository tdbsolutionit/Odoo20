<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template web.login_layout: TDB Solution Giá Trị Cốt Lõi - Corporate Gold Theme -->
    <template id="tdb_login_layout" inherit_id="web.login_layout" priority="99">
        <xpath expr="//t[@t-call='web.frontend_layout']" position="replace">
            <t t-call="web.frontend_layout">
                <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
                <t t-set="body_classname" t-value="'tdb-login-body'"/>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>

                <div class="login-wrapper">
                    <!-- Khu vực bên trái: Trình bày Giá Trị Cốt Lõi -->
                    <aside class="presentation-side">
                        <!-- Logo TDB Solution góc trên bên trái -->
                        <div class="top-brand-logo">
                            <img src="/tdb_website_custom/static/src/img/tdb_logo.png?v=20261102_logo2" alt="TDB Solution" class="brand-logo-img"/>
                        </div>

                        <!-- Khối nội dung chính giữa: Tiêu đề & 3 Card Giá trị cốt lõi -->
                        <div class="core-content-center">
                            <div class="core-heading-wrap">
                                <h1 class="core-title">
                                    <span class="word-navy">GIÁ TRỊ</span>
                                    <span class="word-gold">CỐT LÕI</span>
                                </h1>
                                <div class="title-gold-line"/>
                                <p class="core-subtitle">
                                    TDB Solution sáng tạo và đổi mới, mang đến khách hàng sự hài lòng<br/>
                                    nhờ đồng hành và cung cấp dịch vụ chất lượng cao.
                                </p>
                            </div>

                            <!-- 3 Card Giá trị cốt lõi -->
                            <div class="values-row">
                                <!-- Card 1: Tận Tâm -->
                                <div class="value-card">
                                    <div class="value-card-header">
                                        <div class="value-icon-box">
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart-handshake">
                                                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                                                <path d="M12 5 9.04 7.96a2.17 2.17 0 0 0 0 3.08v0c.82.82 2.13.85 3 .07l2.07-1.9a2.82 2.82 0 0 1 3.79 0l2.96 2.66"/>
                                                <path d="m18 15-2-2"/>
                                                <path d="m15 18-2-2"/>
                                            </svg>
                                        </div>
                                        <div class="value-divider"/>
                                        <h3 class="value-title">Tận Tâm</h3>
                                    </div>
                                    <p class="value-desc">
                                        Tận tâm trong phục vụ,<br/>
                                        tiên phong trong công nghệ.
                                    </p>
                                </div>

                                <!-- Card 2: Đồng Hành -->
                                <div class="value-card">
                                    <div class="value-card-header">
                                        <div class="value-icon-box">
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users">
                                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                                <circle cx="9" cy="7" r="4"/>
                                                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                            </svg>
                                        </div>
                                        <div class="value-divider"/>
                                        <h3 class="value-title">Đồng Hành</h3>
                                    </div>
                                    <p class="value-desc">
                                        Đồng hành bền vững,<br/>
                                        đổi mới không ngừng.
                                    </p>
                                </div>

                                <!-- Card 3: Bền Vững -->
                                <div class="value-card">
                                    <div class="value-card-header">
                                        <div class="value-icon-box">
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check">
                                                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                                                <path d="m9 12 2 2 4-4"/>
                                            </svg>
                                        </div>
                                        <div class="value-divider"/>
                                        <h3 class="value-title">Bền Vững</h3>
                                    </div>
                                    <p class="value-desc">
                                        Bền vững trong chiến lược,<br/>
                                        bản lĩnh trong hành động.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Chân trang góc dưới bên trái -->
                        <div class="page-footer-left">
                            © 2026 TDB-Solution · Phiên bản nội bộ
                        </div>
                    </aside>

                    <!-- Khu vực bên phải: Login Card nổi -->
                    <main class="login-card-side">
                        <div class="login-card position-relative">
                            <!-- Chuyển đổi ngôn ngữ trực tiếp trên trang Đăng nhập -->
                            <div class="position-absolute top-0 end-0 p-3 user-select-none" style="z-index: 5;">
                                <div class="btn-group btn-group-sm bg-white rounded-pill p-1 shadow-sm border" role="group">
                                    <a href="/web/session/switch_language_http?lang=vi_VN&amp;redirect=/web/login"
                                       t-attf-class="btn btn-sm rounded-pill px-2 py-0 fw-semibold text-decoration-none #{'btn-primary text-white' if (request.env.context.get('lang') or 'vi_VN').startswith('vi') else 'text-muted'}"
                                       style="font-size: 11px;">
                                        🇻🇳 VI
                                    </a>
                                    <a href="/web/session/switch_language_http?lang=en_US&amp;redirect=/web/login"
                                       t-attf-class="btn btn-sm rounded-pill px-2 py-0 fw-semibold text-decoration-none #{'btn-primary text-white' if not (request.env.context.get('lang') or 'vi_VN').startswith('vi') else 'text-muted'}"
                                       style="font-size: 11px;">
                                        🇬🇧 EN
                                    </a>
                                </div>
                            </div>

                            <!-- Logo TDB Solution trong Card -->
                            <div class="card-logo-wrap">
                                <img src="/tdb_website_custom/static/src/img/tdb_logo.png?v=20261102_logo2" alt="TDB Solution" class="card-logo"/>
                            </div>

                            <h2 class="card-title">Đăng nhập</h2>
                            <p class="card-subtitle">Chào mừng trở lại! Vui lòng đăng nhập vào hệ thống TDB Solution.</p>

                            <!-- Form Đăng nhập cắm tại đây (Form Odoo chuẩn, hoàn toàn tự nhiên, không mã hóa) -->
                            <t t-out="0"/>

                            <!-- Nút Demo: admin hỗ trợ đăng nhập nhanh -->
                            <div class="demo-btn-wrap mt-3">
                                <button type="button" class="btn-demo" onclick="var l=document.getElementById('login'),p=document.getElementById('password');if(l)l.value='admin';if(p)p.value='MatKhauMoi';" title="Nhấp để tự động điền tài khoản demo">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-key-round">
                                        <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 1 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/>
                                        <circle cx="16.5" cy="7.5" fill="currentColor" r=".5"/>
                                    </svg>
                                    <span>Demo: admin</span>
                                </button>
                            </div>

                            <!-- Chân Card -->
                            <div class="card-footer">
                                TDB Solution © 2026.
                            </div>
                        </div>
                    </main>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
