<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_sale_tree_view_inherit_tdb" model="ir.ui.view">
        <field name="name">product.template.tree.inherit.tdb</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <!-- Nút Delete hình chữ nhật màu đen xám tối, không bị chói -->
            <xpath expr="//list" position="inside">
                <button name="action_custom_delete" 
                        type="object" 
                        string="Delete" 
                        class="btn btn-dark btn-sm text-white" 
                        confirm="Bạn có chắc chắn muốn xóa sản phẩm này không?"/>
            </xpath>
        </field>
    </record>
</odoo>
