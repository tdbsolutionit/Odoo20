# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# IDE, Editor & Agent files
.vscode/
.idea/
.agents/
.gemini/
.stubs/
jsconfig.json
pyrightconfig.json
*.swp
*.swo

# Environment variables & Sensitive credentials (CRITICAL)
.env
.env.*
!.env.example
*.key
*.pem
*.pfx

# Local data directories & volumes
postgres-data/
odoo-data/
videos/
scratch/
Picture/

# Temporary / Debug dumps & scripts
*.log
check_header.py
inspect_live.py
live_*.html
huong_dan_lay_module.md
PLM Learn.md
image.png

# Configuration files with local credentials
!config/odoo.conf
!config/odoo.conf.example

# Old directories
shared-addons/
shared_addons/

# ================================================================================
